# Copy this file to .env and fill in your own values.

# --- MongoDB Atlas (required) ---
# Get this from your Atlas cluster: "Connect" > "Drivers" > copy the connection string,
# then replace <password> with your database user's password.
# Example: mongodb+srv://nvfresh_user:yourpassword@cluster0.abcde.mongodb.net/nvfresh?retryWrites=true&w=majority
MONGODB_URI=

# --- File storage ---
# Where uploaded images (product photos, admin's QR code) get stored.
#   gridfs (default) — stored inside your MongoDB Atlas cluster. No extra
#                       service or account needed beyond MONGODB_URI above.
#   local             — saved to server/uploads/ on disk. Dev/fallback only —
#                       most hosts wipe local disk on redeploy/restart.
#   s3                — Amazon S3 or any S3-compatible bucket (Cloudflare R2,
#                       Backblaze B2, DigitalOcean Spaces, MinIO). Requires
#                       `npm install @aws-sdk/client-s3` and the S3_* vars
#                       below. See server/storage/S3StorageProvider.js.
STORAGE_PROVIDER=gridfs
# GRIDFS_BUCKET=uploads

# Only used when STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=

# --- WhatsApp Cloud API (optional) ---
# The app runs fine without these — WhatsApp notifications just stay off.
# Get these from https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Name of your approved message template (Meta Business Manager > Message Templates).
# Must have a BODY component with 4 text placeholders: {{1}} customer name,
# {{2}} order id, {{3}} total amount, {{4}} advance paid.
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Separate approved template for the admin new-order alert, sent to the phone
# number in Admin -> Settings whenever a customer places an order. Must have
# a BODY component with 4 text placeholders: {{1}} customer name, {{2}} order
# id, {{3}} total amount, {{4}} customer phone.
WHATSAPP_ADMIN_TEMPLATE_NAME=order_alert_admin
WHATSAPP_ADMIN_TEMPLATE_LANG=en
