# Copy this file to .env and fill in your own values.

# --- Admin auth (required) ---
# Signs admin session tokens (Admin panel login). Previously hardcoded with
# no override — change this to a random secret before deploying to
# production, or anyone who's seen the source can forge an admin token.
JWT_SECRET=change_this_to_a_random_secret

# --- Customer login (required for placing/viewing orders) ---
# Google sign-in verification — same value as VITE_FIREBASE_PROJECT_ID in
# customer/.env. No secret key needed here — verifying a customer's Google
# sign-in only needs Google's public certs, not a private credential.
FIREBASE_PROJECT_ID=

# --- Firebase Cloud Messaging (admin website push notifications) ---
# Service-account values from Firebase Console > Project settings >
# Service accounts. Never expose these values to a browser or commit them.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Signs the session token issued after a customer verifies their phone OTP
# (sent via SMS — see SMSGATE_* below) — also the HMAC key OTP codes are
# hashed with before being stored. Change this to a random secret before
# deploying to production.
CUSTOMER_JWT_SECRET=nvfresh_customer_dev_secret_change_in_production

# --- MSG91 OTP Widget (customer website only) ---
# Server-side Authkey for validating the access token returned by MSG91 after
# the customer enters their OTP. Never expose this value to the browser.
MSG91_AUTHKEY=

# --- MSG91 admin order SMS ---
# Approved MSG91 Flow template configuration. The template should define
# VAR1=order ID, VAR2=amount, and VAR3=customer name.
MSG91_AUTH_KEY=
MSG91_ADMIN_SMS_TEMPLATE_ID=
ADMIN_NOTIFICATION_MOBILE=

# --- Telegram admin order notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# --- MongoDB Atlas (required) ---
# Get this from your Atlas cluster: "Connect" > "Drivers" > copy the connection string,
# then replace <password> with your database user's password.
# Example: mongodb+srv://nvfresh_user:yourpassword@cluster0.abcde.mongodb.net/nvfresh?retryWrites=true&w=majority
MONGODB_URI=

# --- File storage ---
# Where uploaded images (product photos, admin's QR code) get stored.
#   gridfs (default) — stored inside your MongoDB Atlas cluster. No extra
#                       service or account needed beyond MONGODB_URI above.
#   local             — saved to server/uploads/ on disk. Dev/fallback only —
#                       most hosts wipe local disk on redeploy/restart.
#   s3                — Amazon S3 or any S3-compatible bucket (Cloudflare R2,
#                       Backblaze B2, DigitalOcean Spaces, MinIO). Requires
#                       `npm install @aws-sdk/client-s3` and the S3_* vars
#                       below. See server/storage/S3StorageProvider.js.
STORAGE_PROVIDER=gridfs
# GRIDFS_BUCKET=uploads

# Only used when STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=

# --- SMSGate (customer phone/OTP login — delivered via SMS) ---
# OTP is sent via SMS through SMSGate: an Android phone running the "SMS
# Gateway for Android" app, with a SIM, acting as the SMS sender. Chosen
# over a DLT-registered provider (MSG91 etc.) because it needs no
# GST/Udyam/DLT registration, and over WhatsApp because Meta requires an
# Authentication-category template for OTP content that isn't available on
# every WhatsApp Business Account. Tradeoff: delivery depends entirely on
# that one phone being powered on and online — no fallback if it isn't.
# Get these from the SMSGate Android app: Settings > Cloud server (turn
# Cloud server ON to generate them). Docs: https://docs.sms-gate.app
SMSGATE_API_URL=https://api.sms-gate.app
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# Set to "false" to run the app without real SMSGate credentials (local dev
# only). OTP codes are still generated/hashed/stored normally — only
# delivery is skipped, and the code is only ever printed to the server
# console, never returned to the client. Defaults to enabled (true) when
# unset, so production behavior is unchanged if you don't set this.
SMS_ENABLED=true

# --- WhatsApp Cloud API ---
# Used for every notification EXCEPT customer OTP (that's SMSGate/SMS
# above) — admin new-order alerts, order-received/status/payment
# confirmations. All optional; each just stays off without
# WHATSAPP_ACCESS_TOKEN/PHONE_NUMBER_ID.
# Get these from https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Set to "false" to run the app without real WhatsApp credentials (local
# dev only) — every WhatsApp send below just logs and skips. Defaults to
# enabled (true) when unset, so production behavior is unchanged if you
# don't set this. Does not affect OTP delivery — see SMS_ENABLED above.
WHATSAPP_ENABLED=true

# Meta Graph API version used for every WhatsApp Cloud API call.
WHATSAPP_API_VERSION=v20.0

# Admin new-order alert — sent to the phone number in Admin -> Settings (the
# same one shown on the customer site's Contact Us page) whenever a customer
# places an order. On by default once WHATSAPP_ACCESS_TOKEN/PHONE_NUMBER_ID
# above are set. Requires an approved template with a BODY component and 4
# text placeholders: {{1}} customer name, {{2}} order id, {{3}} total amount,
# {{4}} customer phone.
WHATSAPP_ADMIN_TEMPLATE_NAME=order_alert_admin
WHATSAPP_ADMIN_TEMPLATE_LANG=en

# Customer order confirmation — off by default (set to "true" once you've
# also set up and approved the template below). Requires an approved
# template with a BODY component and 4 text placeholders: {{1}} customer
# name, {{2}} order id, {{3}} total amount, {{4}} advance paid.
WHATSAPP_SEND_CUSTOMER_CONFIRMATION=false
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Payment confirmed — sent to the customer the moment admin marks their
# advance payment "Paid". Requires an approved template with a BODY
# component and 2 text placeholders: {{1}} advance amount, {{2}} order id.
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_NAME=payment_confirmed
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_LANG=en

# Order status updates — sent to the customer whenever admin changes the
# order's fulfillment status (Pending has no message of its own; it's
# covered by the order-received message above). Each requires an approved
# template with a BODY component and the listed text placeholders.
# order_preparing: {{1}} order id
WHATSAPP_PREPARING_TEMPLATE_NAME=order_preparing
WHATSAPP_PREPARING_TEMPLATE_LANG=en
# order_delivered: {{1}} order id
WHATSAPP_DELIVERED_TEMPLATE_NAME=order_delivered
WHATSAPP_DELIVERED_TEMPLATE_LANG=en
# order_cancelled: {{1}} order id, {{2}} cancellation reason
WHATSAPP_CANCELLED_TEMPLATE_NAME=order_cancelled
WHATSAPP_CANCELLED_TEMPLATE_LANG=en
