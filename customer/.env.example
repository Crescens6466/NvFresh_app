# Only needed for production deployments (e.g. Vercel), where there's no
# dev-server proxy to reach the backend. Set this to your deployed API's URL.
VITE_API_URL=https://your-backend-url.example.com/api

# --- Firebase (customer login — phone/OTP + Google) ---
# Firebase Console > Project settings > General > Your apps > SDK setup and
# configuration. Required for login, checkout, and order history to work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
